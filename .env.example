# Copy to .env.local for local work; add the same names in your hosting dashboard for production.
# NEVER commit real values.

# Public URL of the site (used for sitemap, canonical URLs, social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.edu.pk

# Contact form delivery via Resend (https://resend.com). The form refuses to
# report success unless these are set and the email provider accepts the message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # the Professor's official institutional email
CONTACT_FROM_EMAIL=          # a sender on a domain verified in Resend, e.g. "Website <website@yourdomain.pk>"

# Optional extra spam protection: Cloudflare Turnstile (https://www.cloudflare.com/products/turnstile/)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
